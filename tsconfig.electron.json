{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "outDir": "dist-electron",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "lib": ["ES2020", "DOM"]
  },
  "include": [
    "electron/**/*.ts",
    "src/domain/dailySchedule.ts",
    "src/domain/todoFilters.ts",
    "src/domain/types.ts"
  ]
}
